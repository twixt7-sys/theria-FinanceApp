# Copy to .env.local and fill in from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# These are not secrets: Firebase web config ships in every client bundle and
# identifies the project rather than authenticating it. Access is controlled by
# Firestore security rules and App Check.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (Project settings -> App Check). Required once enforcement is on.
VITE_RECAPTCHA_V3_SITE_KEY=

# Dev only: the debug token printed to the browser console on first run,
# registered under App Check -> your app -> Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
